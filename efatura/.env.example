# efatura/.env olarak kopyalayıp doldurun — bu dosya (.env) kökteki .gitignore
# kuralıyla (eğik çizgisiz ".env" her dizinde eşleşir) zaten commit edilmez.

# Supabase Dashboard → Project Settings → API → service_role (secret) key.
# ⚠️ anon key DEĞİL — service_role RLS'i bypass eder, asla NicePOS'un
# dart-define'larıyla (anon key) karıştırılmamalı, asla istemciye/web'e sızmamalı.
SUPABASE_URL=https://maogkrllltlxkfdwfsdj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# EDM Bilişim e-Fatura/e-Arşiv API bilgileri — henüz yok, EDM'den istenmesi
# gereken liste için bkz. notes/e-fatura-entegrasyonu.md
EDM_USERNAME=
EDM_PASSWORD=
EDM_ENDPOINT=
