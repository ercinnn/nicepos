# Claude Code
.claude/

# .env root'ta ignore, ama docs/assets içinde gerekli
!docs/assets/.env

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Supabase credentials — do not commit
.vscode/launch.json
.env

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/*
!/build/web
/coverage/

# Release APK kopyaları (kök) — commit edilmez, yalnız yerel erişim
/nicepos-etiket.apk
*.apk

# Cloudflare Wrangler yerel oturum/cache (storefront Cloudflare Pages deploy'u)
/.wrangler/

# Supabase CLI yerel önbellek/sürüm kontrolü — commit edilmez
/supabase/.temp/

# Veritabanı yedekleri (pg_dump) — asla commit edilmez, yalnız yerel/harici saklama
*.sql
!supabase/migrations/*.sql

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

